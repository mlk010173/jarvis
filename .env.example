# JARVIS — variáveis de ambiente do backend (server/server.js)
# Copie para .env (local) ou configure no painel do seu host (Render: Environment).
# NUNCA comite valores reais. Nenhum segredo vai para o frontend.

# ---- servidor ----
PORT=3000
# Para onde o OAuth volta depois do login (origem do frontend, SEM barra no fim):
JARVIS_URL=https://mlk010173.github.io/jarvis

# ---- pagamento Pix (opcional; sem isso o checkout Pix fica desativado) ----
PIX_CHAVE=
PIX_NOME=
PIX_CIDADE=

# ---- cupons (opcional) ----
# CUPOM_DESCONTO=10
# CUPONS=BEMVINDO=10,LANCAMENTO=15

# ---- OAuth: cada provedor só aparece no login quando id+segredo estão preenchidos ----
# Escopos pedidos (mínimos, só identidade — nada de Gmail, Drive ou repositórios):
#   Google : openid email profile   (OIDC, com PKCE S256)
#   Discord: identify email
#   GitHub : read:user user:email   (nenhum acesso a repositórios)
# Callbacks para cadastrar no provedor (troque pelo domínio do seu backend):
#   Google  : https://SEU-BACKEND/api/conta/google/callback
#   Discord : https://SEU-BACKEND/api/conta/discord/callback
#   GitHub  : https://SEU-BACKEND/api/conta/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
